# URLs des autres domaines TEKKIL (lib/urls.ts). Optionnelles — chaque
# variable a une valeur par défaut de production dans le code. À définir
# uniquement pour pointer vers un environnement de staging/preview.
NEXT_PUBLIC_APP_URL=https://app.tekkilapp.com
NEXT_PUBLIC_API_URL=https://api.tekkilapp.com/api/v1
NEXT_PUBLIC_SITE_URL=https://tekkilapp.com

# Secret du rafraîchissement instantané des cartes concours (POST
# /api/revalidate, appelé par l'API). Même valeur que
# LANDING_REVALIDATE_SECRET côté tekkil-api. Variable serveur (pas de
# NEXT_PUBLIC_). Vide = route refusée : la landing se rafraîchit seule toutes
# les 5 minutes.
REVALIDATE_SECRET=
